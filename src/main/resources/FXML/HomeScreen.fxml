<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="800.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.github.ricedope.controllers.HomeScreenController">

   <top>
      <VBox spacing="10" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="20" bottom="10" left="20" right="20"/>
         </padding>
         <HBox alignment="CENTER">
            <Label text="Home Screen" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
         </HBox>
      </VBox>
   </top>

   <left>
      <VBox spacing="10" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
         <padding>
            <Insets top="10" bottom="10" left="10" right="10"/>
         </padding>
         <Label text="Help" wrapText="true" maxWidth="Infinity"/>
         <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" maxWidth="300" >
            <content>
               <Accordion maxWidth="300" prefWidth="300" fx:id="helpAccordion">
                  <panes>
                     <TitledPane text="What is this sidebar?" animated="true" fx:id="helpTitlePane">
                        <content>
                           <VBox spacing="5" maxWidth="280">
                              <padding>
                                <Insets top="10" bottom="10" left="10" right="10"/>
                              </padding>
                              <Label text="Look through this sidebar for help with the application" wrapText="true" maxWidth="280"/>
                           </VBox>
                        </content>
                     </TitledPane>
                     <TitledPane text="How to Create XML" animated="true">
                        <content>
                           <VBox spacing="5" maxWidth="280">
                              <padding>
                                <Insets top="10" bottom="10" left="10" right="10"/>
                              </padding>
                              <Label text="This section explains how to create an XML runner file. The full text will wrap and be scrollable if needed." wrapText="true" maxWidth="280"/>
                           </VBox>
                        </content>
                     </TitledPane>
                     <TitledPane text="How to Run XML" animated="true">
                        <content>
                           <VBox spacing="5" maxWidth="280">
                              <padding>
                                <Insets top="10" bottom="10" left="10" right="10"/>
                              </padding>
                              <Label text="This section explains how to run an existing XML runner file with details on usage." wrapText="true" maxWidth="280"/>
                           </VBox>
                        </content>
                     </TitledPane>
                     <TitledPane text="About" animated="true">
                        <content>
                           <VBox spacing="5" maxWidth="280">
                              <padding>
                                <Insets top="10" bottom="10" left="10" right="10"/>
                              </padding>
                              <Label text="Information about Rambling Jesters and this tool with detailed explanation." wrapText="true" maxWidth="280"/>
                           </VBox>
                        </content>
                     </TitledPane>
                  </panes>
               </Accordion>
            </content>
         </ScrollPane>
      </VBox>
   </left>

   <center>
      <VBox alignment="TOP_LEFT" spacing="10" BorderPane.alignment="CENTER_LEFT" VBox.vgrow="ALWAYS" >
         <padding>
            <Insets top="20" left="20" right="20" bottom="20"/>
         </padding>
         <Label text="Welcome to Rambling Jesters! Here you can create and run XML runner files." 
               wrapText="true" maxWidth="800" />
      </VBox>
   </center>

   <right>
      <VBox spacing="10" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="10" bottom="10" left="10" right="10"/>
         </padding>
         <Label text="Create a new Runnable File" wrapText="true" maxWidth="Infinity"/>
         <Button mnemonicParsing="false" onAction="#CreateXML" text="Create" maxWidth="Infinity"/>
         <Label text="Start a new Run" wrapText="true" maxWidth="Infinity"/>
         <Button mnemonicParsing="false" onAction="#RunXML" text="Run" maxWidth="Infinity"/>
      </VBox>
   </right>

   <bottom>
      <HBox alignment="CENTER" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="10" bottom="10"/>
         </padding>
         <Label text="https://github.com/RiceDope/rambling-jesters" style="-fx-font-style: italic;" wrapText="true"/>
      </HBox>
   </bottom>

</BorderPane>
